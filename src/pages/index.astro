---
import HomeScrollytelling from '../components/home/HomeScrollytelling.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/posts';

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
const latestUpdatedAt = allPosts[0]?.data.updatedAt ?? allPosts[0]?.data.publishedAt;
---

<BaseLayout
  title="SORBETSHARKROUNDHAND — AI, Data & Visual Systems"
  description="인공지능을 공부하고 데이터 시스템과 시각적 인터랙션을 만드는 학생 개발자의 프로젝트와 인터랙티브 학습 노트"
  layout="immersive"
>
  <HomeScrollytelling
    latestUpdatedAt={latestUpdatedAt}
    posts={posts}
    totalPosts={allPosts.length}
  />
</BaseLayout>
