---
import AsciiArt from '../components/design/AsciiArt.astro';
import MechanicalLabel from '../components/design/MechanicalLabel.astro';
import PostRow from '../components/posts/PostRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../utils/posts';
import { homeSubjects } from '../utils/topics';
import { withBase } from '../utils/urls';

const posts = (await getPublishedPosts()).slice(0, 4);
const accents = ['cyan', 'red', 'yellow', 'violet'] as const;
---

<BaseLayout
  title="Interactive Notes"
  description="통계, 머신러닝, 인공지능과 수학을 직접 움직이며 이해하는 인터랙티브 학습 노트"
>
  <div class="home">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <MechanicalLabel index="00" label="Index / Learning system" />
        <h1 id="home-title">배운 것을<br /><span>움직이며 이해합니다.</span></h1>
        <p>
          공식과 코드를 읽는 데서 멈추지 않고, 변수를 움직이고 결과를 관찰하며
          이해한 것들을 기록합니다.
        </p>
        <a class="bracket-link" href={withBase('posts/')}>[OPEN ARCHIVE -&gt;]</a>
      </div>
      <div class="home-hero__art">
        <AsciiArt kind="hero" />
      </div>
    </section>

    <section class="recent-notes" aria-labelledby="recent-heading">
      <header class="section-heading">
        <div>
          <MechanicalLabel index="01" label="Recent observations" />
          <h2 id="recent-heading">최근 학습 노트</h2>
        </div>
        <span>{posts.length.toString().padStart(2, '0')} / 04</span>
      </header>
      {posts.length > 0 ? (
        <div class="post-rows">
          {posts.map((post, index) => (
            <PostRow post={post} sequence={index + 1} accent={accents[index]} />
          ))}
        </div>
      ) : (
        <p class="empty-state">아직 기록된 노트가 없습니다. 첫 번째 관찰을 준비하고 있습니다.</p>
      )}
    </section>

    <nav class="topic-index" aria-labelledby="topic-heading">
      <div class="section-heading">
        <div>
          <MechanicalLabel index="02" label="Study coordinates" />
          <h2 id="topic-heading">주제별 탐색</h2>
        </div>
      </div>
      <ul class="topic-index__list">
        {homeSubjects.map((subject, index) => (
          <li>
            <a href={withBase(`topics/${subject.slug}/`)}>
              <span>{(index + 1).toString().padStart(2, '0')}::</span>{subject.label}<b aria-hidden="true">-&gt;</b>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
