---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const firstPostHref = `${base}posts/linear-regression/`;
const topics = [
  ['Statistics', 'statistics'],
  ['Machine Learning', 'machine-learning'],
  ['Deep Learning', 'deep-learning'],
  ['Mathematics', 'mathematics'],
  ['Visualization', 'visualization'],
] as const;
---

<BaseLayout
  title="Interactive Notes"
  description="통계, 머신러닝, 인공지능과 수학을 직접 움직이며 이해하는 인터랙티브 학습 노트"
>
  <div class="home">
    <section class="hero-sheet" aria-labelledby="home-title">
      <div class="hero-index">
        <div>
          <p class="hero-index__label">Interactive Notes</p>
          <p class="hero-index__disciplines">
            Statistics · Machine Learning · AI · Mathematics
          </p>
        </div>

        <div class="coordinate-field" aria-hidden="true">
          <span class="coordinate-field__origin"></span>
          <span class="coordinate-field__x">x — 입력값</span>
          <span class="coordinate-field__y">y — 관찰값</span>
          <span class="coordinate-field__mode">mode / explore</span>
        </div>
      </div>

      <div class="hero-copy">
        <h1 id="home-title">
          <span>Things I learned,</span>{' '}<em>visualized.</em>
        </h1>
        <p class="hero-copy__intro">
          공식과 코드를 읽는 데서 멈추지 않고, 직접 움직이며 이해한 것들을 기록합니다.
        </p>
        <a class="first-note-link" href={firstPostHref}>
          첫 번째 노트 읽기
          <span class="first-note-link__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="observation" aria-labelledby="recent-heading">
      <header>
        <p class="section-label">Recent observation</p>
        <h2 id="recent-heading">최근 노트</h2>
      </header>
      <article class="observation__entry">
        <div>
          <p class="observation__meta">Statistics · Linear models</p>
          <h3>
            <a class="observation-link" href={firstPostHref}>
              Linear Regression — 선형회귀를 눈으로 이해하기
            </a>
          </h3>
        </div>
        <time class="observation__date" datetime="2026-08-09">2026.08.09</time>
      </article>
    </section>

    <nav class="topic-index" aria-labelledby="topic-heading">
      <div>
        <p class="section-label">Study coordinates</p>
        <h2 id="topic-heading">주제별 탐색</h2>
      </div>
      <ul class="topic-index__list">
        {
          topics.map(([label, slug]) => (
            <li><a class="topic-link" href={`${base}topics/${slug}/`}>{label}</a></li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
