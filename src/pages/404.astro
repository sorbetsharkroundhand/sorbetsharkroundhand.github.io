---
import AsciiArt from '../components/design/AsciiArt.astro';
import MechanicalLabel from '../components/design/MechanicalLabel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/urls';
---

<BaseLayout title="404 | Interactive Notes" description="요청한 학습 노트를 찾을 수 없습니다.">
  <section class="not-found" aria-labelledby="not-found-title">
    <MechanicalLabel index="404" label="Unregistered coordinate" />
    <h1 id="not-found-title">등록되지 않은 좌표입니다.</h1>
    <p>요청한 노트가 이동했거나 아직 이 학습 지도에 추가되지 않았습니다.</p>
    <AsciiArt kind="404" />
    <div class="not-found__actions">
      <a class="bracket-link" href={withBase('')}>[RETURN HOME -&gt;]</a>
      <a class="bracket-link" href={withBase('posts/')}>[OPEN ARCHIVE -&gt;]</a>
    </div>
  </section>
</BaseLayout>
