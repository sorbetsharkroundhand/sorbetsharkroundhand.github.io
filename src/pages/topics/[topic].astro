---
import MechanicalLabel from '../../components/design/MechanicalLabel.astro';
import PostRow from '../../components/posts/PostRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';
import { getTopicLabel, homeSubjects } from '../../utils/topics';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const topics = [
    ...new Set([...homeSubjects.map((subject) => subject.slug), ...allPosts.flatMap((post) => post.data.topics)]),
  ].sort();

  return topics.map((topic) => ({
    params: { topic },
    props: {
      posts: allPosts.filter((post) => post.data.topics.includes(topic)),
      topic,
    },
  }));
}

const { posts, topic } = Astro.props;
const topicLabel = getTopicLabel(topic);
const accents = ['cyan', 'red', 'yellow', 'violet'] as const;
---

<BaseLayout title={`${topicLabel} | Interactive Notes`} description={`${topicLabel} 주제의 학습 노트`}>
  <section class="listing" aria-labelledby="topic-heading">
    <header class="listing__header">
      <MechanicalLabel index="00" label={`Topic / ${topic}`} />
      <h1 id="topic-heading">{topicLabel}</h1>
      <div>
        <p>이 좌표에서 이어지는 관찰과 계산을 모았습니다.</p>
        <span>{posts.length.toString().padStart(2, '0')} NOTES</span>
      </div>
    </header>
    {posts.length > 0 ? (
      <div class="post-rows">
        {posts.map((post, index) => (
          <PostRow post={post} sequence={index + 1} accent={accents[index % accents.length]} />
        ))}
      </div>
    ) : (
      <p class="empty-state">아직 이 좌표에 등록된 노트가 없습니다. 새로운 관찰을 준비하고 있습니다.</p>
    )}
  </section>
</BaseLayout>
