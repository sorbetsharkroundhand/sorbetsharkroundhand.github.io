---
import { render } from 'astro:content';

import PostLayout from '../../layouts/PostLayout.astro';
import { getPostNeighbors, getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, ...getPostNeighbors(posts, post.id) },
  }));
}

const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
const sectionHeadings = headings.filter(({ depth }) => depth === 2);
---

<PostLayout post={post} older={older} newer={newer} headings={sectionHeadings}>
  <Content />
</PostLayout>
