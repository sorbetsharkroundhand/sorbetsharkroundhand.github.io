---
import MechanicalLabel from '../../components/design/MechanicalLabel.astro';
import PostRow from '../../components/posts/PostRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const accents = ['cyan', 'red', 'yellow', 'violet'] as const;
---

<BaseLayout
  title="Archive | Interactive Notes"
  description="Interactive Notes의 전체 학습 노트"
  layout="immersive"
>
  <section class="listing" aria-labelledby="posts-heading">
    <header class="listing__header">
      <MechanicalLabel index="00" label="Archive / All observations" />
      <h1 id="posts-heading">전체 학습 노트</h1>
      <div>
        <p>공식에서 출발해, 조작과 관찰로 돌아오는 학습 기록입니다.</p>
        <span>{posts.length.toString().padStart(2, '0')} NOTES</span>
      </div>
    </header>
    {posts.length > 0 ? (
      <div class="post-rows">
        {posts.map((post, index) => (
          <PostRow post={post} sequence={index + 1} accent={accents[index % accents.length]} />
        ))}
      </div>
    ) : (
      <p class="empty-state">아직 공개된 노트가 없습니다.</p>
    )}
  </section>
</BaseLayout>
