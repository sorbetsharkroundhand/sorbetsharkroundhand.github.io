---
interface Props {
  label?: string;
  title: string;
}

const { label = 'Interactive instrument', title } = Astro.props;
---

<aside class="interactive-figure-callout" aria-labelledby="interactive-figure-title">
  <p class="interactive-figure-callout__label">{label}</p>
  <h3 id="interactive-figure-title">{title}</h3>
  <div class="interactive-figure-callout__message" role="status">
    <slot />
  </div>
</aside>
