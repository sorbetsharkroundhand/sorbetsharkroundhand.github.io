---
import { withBase } from '../../utils/urls';

const base = withBase('');
const postsHref = withBase('posts/');
const isHome = Astro.url.pathname === base;
const isPosts = Astro.url.pathname.startsWith(postsHref);
const workHref = isHome ? '#home-work' : `${base}#home-work`;
const aboutHref = isHome ? '#home-about' : `${base}#home-about`;
---

<header class="site-header">
  <a class="site-wordmark" href={base} aria-label="sorbetsharkroundhand 홈">
    <span class="site-wordmark__mark" aria-hidden="true">[+]</span>
    <span class="site-wordmark__name">SORBETSHARKROUNDHAND</span>
  </a>
  <nav class="site-nav" aria-label="주요 메뉴">
    <ul class="site-nav__list">
      <li><a href={workHref}>[WORK]</a></li>
      <li><a href={postsHref} aria-current={isPosts ? 'page' : undefined}>[NOTES]</a></li>
      <li><a href={aboutHref}>[ABOUT]</a></li>
    </ul>
  </nav>
</header>
