---
import { withBase } from '../../utils/urls';

interface Props {
  variant?: 'default' | 'immersive';
}

const { variant = 'default' } = Astro.props;
const base = withBase('');
const postsHref = withBase('posts/');
const isHome = Astro.url.pathname === base;
const isPosts = Astro.url.pathname.startsWith(postsHref);
const indexHref = variant === 'immersive' ? '#home-index' : base;
const indexLabel = variant === 'immersive' ? '[INDEX]' : 'Index';
const archiveLabel = variant === 'immersive' ? '[ARCHIVE]' : 'Archive';
---

<header class="site-header">
  <a class="site-wordmark" href={base} aria-label="Interactive Notes 홈">
    <span class="site-wordmark__mark" aria-hidden="true">[+]</span>
    <span class="site-wordmark__name">INTERACTIVE::NOTES</span>
  </a>
  <nav class="site-nav" aria-label="주요 메뉴">
    <ul class="site-nav__list">
      <li><a href={indexHref} aria-current={isHome ? 'page' : undefined}>{indexLabel}</a></li>
      <li><a href={postsHref} aria-current={isPosts ? 'page' : undefined}>{archiveLabel}</a></li>
    </ul>
  </nav>
</header>
