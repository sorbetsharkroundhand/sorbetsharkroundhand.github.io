---
import type { CollectionEntry } from 'astro:content';

import AsciiArt from '../components/design/AsciiArt.astro';
import MechanicalLabel from '../components/design/MechanicalLabel.astro';
import PostPager from '../components/posts/PostPager.astro';
import PostIndex, { type PostHeading } from '../components/posts/PostIndex.astro';
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/urls';

interface Props {
  post: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
  newer?: CollectionEntry<'posts'>;
  headings: readonly PostHeading[];
}

const { post, older, newer, headings } = Astro.props;
const { data: frontmatter } = post;
const publishedLabel = frontmatter.publishedAt.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout
  title={`${frontmatter.title} | Interactive Notes`}
  description={frontmatter.description}
  layout="immersive"
>
  <div class="reading-progress" aria-hidden="true">
    <span data-reading-bar></span>
  </div>

  <article class="article">
    <div class="article-rail">
      <a class="article-back" href={withBase('posts/')}>&lt;- [ALL NOTES]</a>
      <AsciiArt slug={post.id} category={frontmatter.category} kind="detail" />
    </div>

    <header class="article-header">
      <MechanicalLabel index="01" label={frontmatter.category} />
      <h1>{frontmatter.title}</h1>
      <p class="article-header__subtitle">{frontmatter.subtitle}</p>
      <p class="article-header__description">{frontmatter.description}</p>
      <div class="article-header__meta">
        <time datetime={frontmatter.publishedAt.toISOString()}>PUBLISHED::{publishedLabel}</time>
        <ul aria-label={`${frontmatter.title} 주제`}>
          {frontmatter.topics.map((topic) => (
            <li><a href={withBase(`topics/${topic}/`)}>#{topic}</a></li>
          ))}
        </ul>
      </div>
    </header>

    <div class="article-reading-shell">
      <PostIndex headings={headings} />
      <div class="article-prose">
        <slot />
      </div>
    </div>

    <PostPager older={older} newer={newer} />
  </article>
</BaseLayout>

<script>
  import { mountVisualizations } from '../visualizations/mount-visualizations';

  let activeCleanup: (() => void) | null = null;

  const mountReadingExperience = () => {
    const bar = document.querySelector<HTMLElement>('[data-reading-bar]');
    const article = document.querySelector('article.article');
    const headings = document.querySelectorAll<HTMLElement>('.article-prose h2');

    const cleanupFns: (() => void)[] = [];

    let scrollFrame = 0;
    if (bar && article) {
      const updateProgress = () => {
        scrollFrame = 0;
        const bounds = article.getBoundingClientRect();
        const total = bounds.height - window.innerHeight;
        const scrolled = Math.min(Math.max(-bounds.top, 0), Math.max(total, 1));
        bar.style.setProperty(
          '--reading-progress',
          total > 0 ? (scrolled / total).toFixed(4) : '1',
        );
      };
      const requestProgress = () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(updateProgress);
      };
      updateProgress();
      document.addEventListener('scroll', requestProgress, { passive: true });
      window.addEventListener('resize', requestProgress);
      cleanupFns.push(() => {
        if (scrollFrame) cancelAnimationFrame(scrollFrame);
        document.removeEventListener('scroll', requestProgress);
        window.removeEventListener('resize', requestProgress);
      });
    }

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.setAttribute('data-reveal', 'visible');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      for (const heading of headings) {
        heading.setAttribute('data-reveal', 'pending');
        observer.observe(heading);
      }
      cleanupFns.push(() => observer.disconnect());
    }

    cleanupFns.push(mountVisualizations());
    activeCleanup = () => cleanupFns.forEach((fn) => fn());
  };

  const unmountReadingExperience = () => {
    activeCleanup?.();
    activeCleanup = null;
  };

  document.addEventListener('astro:page-load', mountReadingExperience);
  document.addEventListener('astro:before-swap', unmountReadingExperience);
</script>
