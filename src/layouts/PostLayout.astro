---
import type { CollectionEntry } from 'astro:content';

import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/urls';

interface Props {
  frontmatter: CollectionEntry<'posts'>['data'];
}

const { frontmatter } = Astro.props;
const publishedLabel = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'UTC',
}).format(frontmatter.publishedAt);
---

<BaseLayout title={`${frontmatter.title} — Interactive Notes`} description={frontmatter.description}>
  <article class:list={['article', { 'article--wide-figures': frontmatter.wideFigures }]}>
    <a class="article-back" href={withBase('posts/')}>← 모든 노트</a>

    <header class="article-header">
      <p class="article-header__category">{frontmatter.category}</p>
      <h1>{frontmatter.title}</h1>
      <p class="article-header__description">{frontmatter.description}</p>
      <time datetime={frontmatter.publishedAt.toISOString()}>{publishedLabel}</time>
    </header>

    <div class="article-prose">
      <slot />
    </div>
  </article>
</BaseLayout>
